# ===========================================
# Docker Configuration
# ===========================================
UID=1000
GID=1000

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_DB=kavas_lunch
POSTGRES_USER=laravel
POSTGRES_PASSWORD=password

# ===========================================
# Application
# ===========================================
APP_NAME="KAVAS-LUNCH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ===========================================
# Logging
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================
# Database - PostgreSQL
# ===========================================
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=kavas_lunch
DB_USERNAME=laravel
DB_PASSWORD=password

# ===========================================
# Session
# ===========================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ===========================================
# Cache & Queue - Redis
# ===========================================
CACHE_DRIVER=redis
CACHE_STORE=redis
CACHE_PREFIX=kavas_lunch_cache

QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default

# ===========================================
# Redis Configuration
# ===========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# ===========================================
# Broadcasting & Filesystem
# ===========================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ===========================================
# Mail Configuration - MailHog (Development)
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@kavaslunch.upch.pe"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=
JWT_TTL=120
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=30

# ===========================================
# CORS & Frontend
# ===========================================
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ===========================================
# AWS (Optional)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===========================================
# Vite
# ===========================================
VITE_APP_NAME="${APP_NAME}"
